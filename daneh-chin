<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>شرکت دانه چین | خوراک دام و کشاورزی</title>

  <meta name="description"
        content="شرکت دانه چین، ارائه دهنده محصولات و خوراک دام با کیفیت">

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap');

    :root {
      --green: #173f24;
      --green2: #286b3b;
      --light-green: #eaf4e9;
      --gold: #d6a63a;
      --cream: #faf8f0;
      --dark: #142019;
      --white: #fff;
      --gray: #66736a;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Vazirmatn", Tahoma, sans-serif;
      background: var(--cream);
      color: var(--dark);
      overflow-x: hidden;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* ================= HEADER ================= */

    header {
      position: fixed;
      top: 0;
      right: 0;
      width: 100%;
      z-index: 1000;
      padding: 18px 6%;
      transition: .4s;
    }

    header.scrolled {
      background: rgba(20, 45, 27, .96);
      backdrop-filter: blur(15px);
      padding: 12px 6%;
      box-shadow: 0 5px 25px rgba(0,0,0,.15);
    }

    .nav {
      max-width: 1250px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: white;
      font-weight: 900;
      font-size: 23px;
    }

    .logo-icon {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: var(--gold);
      display: grid;
      place-items: center;
      font-size: 25px;
      box-shadow: 0 5px 20px rgba(214,166,58,.35);
    }

    nav {
      display: flex;
      gap: 28px;
      color: white;
      font-size: 14px;
      font-weight: 500;
    }

    nav a {
      position: relative;
      padding: 8px 0;
    }

    nav a::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: 0;
      width: 0;
      height: 2px;
      background: var(--gold);
      transition: .3s;
    }

    nav a:hover::after {
      width: 100%;
    }

    .nav-button {
      background: var(--gold);
      color: #1c2b1e;
      padding: 11px 20px;
      border-radius: 30px;
      font-weight: 700;
      font-size: 13px;
      transition: .3s;
    }

    .nav-button:hover {
      transform: translateY(-3px);
      background: white;
    }

    .menu-btn {
      display: none;
      color: white;
      font-size: 28px;
      cursor: pointer;
    }

    /* ================= HERO ================= */

    .hero {
      min-height: 100vh;
      position: relative;
      display: flex;
      align-items: center;
      background:
        linear-gradient(
          90deg,
          rgba(10,28,15,.88) 0%,
          rgba(10,28,15,.65) 45%,
          rgba(10,28,15,.18) 100%
        ),
        url("https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=2200&q=90");

      background-size: cover;
      background-position: center;
    }

    .hero-content {
      max-width: 1250px;
      width: 100%;
      margin: auto;
      padding: 120px 6% 70px;
      color: white;
    }

    .small-title {
      display: inline-block;
      color: #f2cf72;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 18px;
      letter-spacing: 1px;
    }

    .hero h1 {
      font-size: clamp(45px, 7vw, 82px);
      line-height: 1.15;
      font-weight: 900;
      max-width: 700px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 600px;
      margin-top: 22px;
      line-height: 2.2;
      font-size: 17px;
      color: rgba(255,255,255,.88);
    }

    .hero-buttons {
      display: flex;
      gap: 15px;
      margin-top: 35px;
    }

    .primary-btn,
    .outline-btn {
      padding: 14px 28px;
      border-radius: 35px;
      font-weight: 700;
      transition: .3s;
    }

    .primary-btn {
      background: var(--gold);
      color: #172619;
    }

    .outline-btn {
      border: 1px solid rgba(255,255,255,.6);
      color: white;
      background: rgba(255,255,255,.08);
      backdrop-filter: blur(8px);
    }

    .primary-btn:hover,
    .outline-btn:hover {
      transform: translateY(-5px);
    }

    .hero-bottom {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 100%;
      height: 120px;
      background: linear-gradient(transparent, var(--cream));
    }

    /* ================= STATS ================= */

    .stats {
      position: relative;
      z-index: 5;
      margin-top: -45px;
      padding: 0 6%;
    }

    .stats-box {
      max-width: 1100px;
      margin: auto;
      background: white;
      border-radius: 25px;
      padding: 28px;
      box-shadow: 0 20px 50px rgba(0,0,0,.10);

      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      text-align: center;
    }

    .stat {
      border-left: 1px solid #e4e8e3;
    }

    .stat:last-child {
      border: 0;
    }

    .stat strong {
      display: block;
      color: var(--green);
      font-size: 32px;
      font-weight: 900;
    }

    .stat span {
      color: var(--gray);
      font-size: 13px;
    }

    /* ================= GENERAL ================= */

    section {
      padding: 100px 6%;
    }

    .section-head {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 55px;
    }

    .section-head small {
      color: var(--green2);
      font-weight: 800;
    }

    .section-head h2 {
      font-size: clamp(30px, 5vw, 48px);
      color: var(--green);
      margin-top: 10px;
      font-weight: 900;
    }

    .section-head p {
      margin-top: 15px;
      color: var(--gray);
      line-height: 2;
    }

    /* ================= PRODUCTS ================= */

    .products {
      background: white;
    }

    .product-grid {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .product-card {
      background: #fff;
      border-radius: 25px;
      overflow: hidden;
      border: 1px solid #edf0eb;
      box-shadow: 0 10px 35px rgba(0,0,0,.06);
      transition: .4s;
    }

    .product-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 25px 50px rgba(0,0,0,.12);
    }

    .product-image {
      height: 240px;
      overflow: hidden;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: .6s;
    }

    .product-card:hover img {
      transform: scale(1.08);
    }

    .product-info {
      padding: 25px;
    }

    .product-info h3 {
      color: var(--green);
      font-size: 20px;
      margin-bottom: 10px;
    }

    .product-info p {
      color: var(--gray);
      line-height: 1.9;
      font-size: 14px;
    }

    .product-link {
      display: inline-block;
      margin-top: 18px;
      color: var(--green2);
      font-weight: 800;
      font-size: 13px;
    }

    /* ================= ABOUT ================= */

    .about {
      background: var(--light-green);
    }

    .about-container {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .about-image {
      position: relative;
    }

    .about-image img {
      width: 100%;
      height: 520px;
      object-fit: cover;
      border-radius: 35px;
      box-shadow: 20px 25px 60px rgba(0,0,0,.15);
    }

    .about-badge {
      position: absolute;
      bottom: 25px;
      right: -25px;
      background: var(--gold);
      color: #1c2b1e;
      padding: 20px 25px;
      border-radius: 20px;
      font-weight: 900;
      box-shadow: 0 10px 30px rgba(0,0,0,.15);
    }

    .about-text small {
      color: var(--green2);
      font-weight: 800;
    }

    .about-text h2 {
      color: var(--green);
      font-size: 43px;
      margin: 12px 0 20px;
      font-weight: 900;
    }

    .about-text p {
      color: var(--gray);
      line-height: 2.2;
      margin-bottom: 15px;
    }

    .features {
      margin-top: 30px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .feature {
      background: white;
      padding: 15px;
      border-radius: 15px;
      font-size: 13px;
      font-weight: 700;
      color: var(--green);
    }

    /* ================= ANIMALS ================= */

    .animals {
      background: white;
    }

    .animal-grid {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
    }

    .animal {
      height: 400px;
      border-radius: 30px;
      overflow: hidden;
      position: relative;
    }

    .animal img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: .6s;
    }

    .animal:hover img {
      transform: scale(1.07);
    }

    .animal-info {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 100%;
      padding: 35px;
      color: white;
      background: linear-gradient(
        transparent,
        rgba(0,0,0,.8)
      );
    }

    .animal-info h3 {
      font-size: 28px;
    }

    /* ================= CONTACT ================= */

    .contact {
      background: var(--green);
      color: white;
    }

    .contact-container {
      max-width: 1150px;
      margin: auto;
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 60px;
      align-items: center;
    }

    .contact-info h2 {
      font-size: 45px;
      margin-bottom: 20px;
    }

    .contact-info p {
      color: rgba(255,255,255,.7);
      line-height: 2;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-top: 25px;
    }

    .contact-icon {
      width: 48px;
      height: 48px;
      background: rgba(255,255,255,.1);
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 20px;
    }

    .contact-form {
      background: white;
      padding: 35px;
      border-radius: 25px;
    }

    .contact-form h3 {
      color: var(--green);
      margin-bottom: 20px;
      font-size: 25px;
    }

    .input {
      width: 100%;
      border: 1px solid #e1e6e1;
      background: #fafcfa;
      padding: 14px;
      border-radius: 12px;
      margin-bottom: 13px;
      outline: none;
      font-family: inherit;
    }

    textarea.input {
      height: 130px;
      resize: none;
    }

    .submit {
      width: 100%;
      border: 0;
      cursor: pointer;
      background: var(--gold);
      color: #172619;
      padding: 14px;
      border-radius: 12px;
      font-family: inherit;
      font-weight: 800;
      font-size: 15px;
    }

    /* ================= FOOTER ================= */

    footer {
      background: #0d2414;
      color: white;
      padding: 30px 6%;
      text-align: center;
      font-size: 13px;
      color: rgba(255,255,255,.65);
    }

    footer strong {
      color: var(--gold);
    }

    /* ================= MOBILE ================= */

    @media(max-width: 850px) {

      header {
        padding: 14px 5%;
      }

      nav,
      .nav-button {
        display: none;
      }

      .menu-btn {
        display: block;
      }

      nav.active {
        display: flex;
        position: absolute;
        top: 75px;
        right: 5%;
        left: 5%;
        padding: 20px;
        background: rgba(20,45,27,.98);
        border-radius: 20px;
        flex-direction: column;
        gap: 5px;
        box-shadow: 0 20px 40px rgba(0,0,0,.2);
      }

      nav.active a {
        padding: 13px;
      }

      .hero {
        background:
          linear-gradient(
            rgba(5,25,12,.72),
            rgba(5,25,12,.82)
          ),
          url("https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=1600&q=85");

        background-position: center;
      }

      .hero-content {
        text-align: center;
      }

      .hero p {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-buttons {
        justify-content: center;
      }

      .stats-box {
        grid-template-columns: 1fr;
      }

      .stat {
        border-left: 0;
        border-bottom: 1px solid #e4e8e3;
        padding-bottom: 15px;
      }

      .stat:last-child {
        border: 0;
      }

      .product-grid {
        grid-template-columns: 1fr;
      }

      .about-container {
        grid-template-columns: 1fr;
        gap: 40px;
      }

      .about-image img {
        height: 400px;
      }

      .about-badge {
        right: 15px;
      }

      .animal-grid {
        grid-template-columns: 1fr;
      }

      .contact-container {
        grid-template-columns: 1fr;
      }
    }

    @media(max-width: 500px) {

      section {
        padding: 75px 5%;
      }

      .hero-content {
        padding: 120px 5% 70px;
      }

      .hero h1 {
        font-size: 45px;
      }

      .hero-buttons {
        flex-direction: column;
      }

      .primary-btn,
      .outline-btn {
        text-align: center;
      }

      .features {
        grid-template-columns: 1fr;
      }

      .contact-form {
        padding: 22px;
      }
    }

  </style>
</head>

<body>

